APP_NAME=Task Management System
ENVIRONMENT=production
DEBUG=false

# Generate unique random secrets; never use these placeholder values as-is.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# MySQL 5.7 connection. The database is managed separately and must be reachable on the Docker network.
# Use URL-safe alphanumeric passwords.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=task_db
MYSQL_USER=task_user
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD

CORS_ORIGINS=https://task.tinateck.ir,http://task.tinateck.ir

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# First admin account created automatically on initial startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARS
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=سیستم
ADMIN_EMAIL=admin@tinateck.ir
